# Application
NODE_ENV=development
PORT=4002

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/helpmyielts_dev

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=10

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:4000

# Optional: Redis (for future microservices)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
