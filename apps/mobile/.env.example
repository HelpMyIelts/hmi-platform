# API base URL. Must be prefixed EXPO_PUBLIC_ to be readable in app code —
# Expo inlines EXPO_PUBLIC_* vars into the JS bundle at build time, so treat
# them as public/client-visible, never as secrets.
#
# - iOS Simulator: reaches your Mac's localhost directly.
# - Android Emulator: use http://10.0.2.2:3000/api/v1 instead of localhost.
# - Physical device via Expo Go (same Wi-Fi): use your Mac's LAN IP, e.g. http://192.168.1.23:3000/api/v1.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
